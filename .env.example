# Supabase (provision via Vercel Marketplace or supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (provision via Vercel Marketplace or resend.com)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=newsletter@meiringen.org

# Vercel Cron protection — set in Vercel project env vars
CRON_SECRET=generate-a-long-random-string

# Site URL (for OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://meiringen.org
