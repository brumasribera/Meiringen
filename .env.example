# Local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (from Vercel: vercel env pull .env.local --environment=development --yes)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend — install https://vercel.com/integrations/resend on the meiringen project)
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=Meiringen Alerts <alerts@meiringen.life>

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-javascript-api-key

# Google Sign-In (create in Google Cloud Console → Credentials → OAuth client ID)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret

# Cron (production/preview on Vercel)
CRON_SECRET=random-secure-string

# Optional Ubuntu/Codex daily research runner
MEIRINGEN_AI_RESEARCH=1
MEIRINGEN_CODEX_TIMEOUT_MS=720000

# Optional: configure Supabase Auth URLs via scripts/configure-auth.mjs
# SUPABASE_ACCESS_TOKEN=sbp_xxxx
